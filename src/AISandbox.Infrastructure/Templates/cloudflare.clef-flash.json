{
  "templateId": "cloudflare.clef-flash",
  "version": 1,
  "displayName": "Clef Flash",
  "description": "Cloudflare's fast decision model on Workers AI. Calibrated choice, score and noul answers. Accepts images.",
  "kind": "Decision",
  "docsUrl": "https://developers.cloudflare.com/workers-ai/models/clef-flash/",
  "inputSchema": "schemas/systemone.request.json",
  "outputSchema": "schemas/systemone.response.json",
  "routes": [
    {
      "providerKind": "CloudflareWorkersAi",
      "protocol": "workers-ai",
      "remoteId": "clef-flash",
      "capabilities": { "acceptsImages": true, "maxQuestions": 64, "contextTokens": 65536, "questionTypes": [ "choice", "score", "noul" ] },
      "pricing": { "currency": "USD", "inputPerMillion": 0.09, "outputPerMillion": 0 }
    },
    {
      "providerKind": "OpenRouter",
      "protocol": "openrouter-decisions",
      "remoteId": "cloudflare/clef-flash",
      "capabilities": { "acceptsImages": true, "maxQuestions": 64, "contextTokens": 65536, "questionTypes": [ "choice", "score", "noul" ] },
      "pricing": { "currency": "USD", "inputPerMillion": 0.09, "outputPerMillion": 0 }
    }
  ]
}
