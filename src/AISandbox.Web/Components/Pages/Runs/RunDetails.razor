@page "/runs/{Id:guid}"
@using AISandbox.Application.Features.Runs
@using AISandbox.Domain.Experimentation
@implements IAsyncDisposable
@using AISandbox.Application.Abstractions
@inject UseCases UseCases
@inject IRunNotifier Notifier

<PageTitle>Run · AI Sandbox</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_run is null)
{
    <MudAlert Severity="Severity.Warning">Run not found.</MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h4">Run</MudText>
        <MudSpacer />
        @if (_run.Status == RunStatus.Running)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop"
                       Disabled="@_cancelling" OnClick="CancelAsync">@(_cancelling ? "Cancelling…" : "Cancel")</MudButton>
        }
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PlayArrow" Href="runs/new">New run</MudButton>
    </MudStack>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@_run.CreatedAt.ToLocalTime().ToString("f")</MudText>
        @if (_run.Status == RunStatus.Running)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Outlined.HourglassTop">
                @(_run.Executions.Count(e => e.Status is ExecutionStatus.Succeeded or ExecutionStatus.Failed)) of @_run.Executions.Count answered
            </MudChip>
        }
        @if (_run.QuestionSet is { } set)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Quiz"
                     Href="@($"question-sets/{set.Id}")">Question set v@(set.Version)</MudChip>
        }
    </MudStack>

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.overline">State</MudText>
        <MudText Typo="Typo.body1" Style="white-space: pre-wrap">@_run.State</MudText>
    </MudPaper>

    @if (_matrix is { } matrix)
    {
        <MudStack Spacing="2" Class="mb-4">
            @foreach (var execution in _run.Executions)
            {
                <MudPaper Outlined="true" Class="px-4 py-2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                        <MudText Typo="Typo.subtitle1">@execution.ModelName</MudText>
                        <StatusChip Status="execution.Status" />
                        @if (execution.Error is { } error)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"><code>@error.Code</code></MudText>
                        }
                        <MudSpacer />
                        <ExecutionMetrics Execution="execution" />
                    </MudStack>
                </MudPaper>
            }
        </MudStack>

        <AnswerMatrixView Matrix="matrix" />

        <MudExpansionPanels Class="mt-4" MultiExpansion="true">
            @foreach (var execution in _run.Executions)
            {
                <MudExpansionPanel Text="@($"{execution.ModelName} · details")">
                    <ExecutionCard Execution="execution" Questions="_run.Questions" />
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
    else
    {
        <MudStack Spacing="4">
            @foreach (var execution in _run.Executions)
            {
                <ExecutionCard Execution="execution" Questions="_run.Questions" />
            }
        </MudStack>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private RunView? _run;
    private AnswerMatrix? _matrix;
    private bool _loading = true;
    private bool _cancelling;
    private bool _disposed;
    private bool _refreshing;
    private bool _refreshAgain;
    private IDisposable? _subscription;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _subscription?.Dispose();
        // Subscribe before loading so no event falls between the two.
        _subscription = Notifier.Subscribe(new RunId(Id), runEvent => { _ = InvokeAsync(RefreshAsync); });
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _run = await UseCases.QueryAsync<GetRun, RunView?>(new GetRun(new RunId(Id)));
        _matrix = _run is null ? null : AnswerMatrix.Of(_run);
        if (_run?.Status == RunStatus.Completed)
        {
            _cancelling = false;
        }
    }

    // Events can arrive in bursts; reload one at a time and once more if any came in meanwhile.
    private async Task RefreshAsync()
    {
        if (_disposed)
        {
            return;
        }

        if (_refreshing)
        {
            _refreshAgain = true;
            return;
        }

        _refreshing = true;
        try
        {
            do
            {
                _refreshAgain = false;
                await LoadAsync();
                StateHasChanged();
            }
            while (_refreshAgain && !_disposed);
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task CancelAsync()
    {
        _cancelling = true;
        await UseCases.SendAsync<CancelRun, RunId>(new CancelRun(new RunId(Id)));
        await RefreshAsync();
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        _subscription?.Dispose();
        return ValueTask.CompletedTask;
    }
}
