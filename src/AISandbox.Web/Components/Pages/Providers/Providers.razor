@page "/providers"
@using AISandbox.Application.Features.Providers
@using AISandbox.Domain.Catalog.Providers
@inject UseCases UseCases
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Providers · AI Sandbox</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Providers</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="RegisterAsync">
        Register provider
    </MudButton>
</MudStack>

@if (_providers is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_providers.Count == 0)
{
    <MudPaper Outlined="true" Class="pa-8 d-flex flex-column align-center">
        <MudIcon Icon="@Icons.Material.Outlined.Hub" Size="Size.Large" Color="Color.Secondary" />
        <MudText Typo="Typo.body1" Class="mt-3">No providers yet.</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Register one to start adding models.</MudText>
    </MudPaper>
}
else
{
    <MudTable Items="_providers" Hover="true" Outlined="true" Elevation="0" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Kind</MudTh>
            <MudTh>Base URL</MudTh>
            <MudTh>API key</MudTh>
            <MudTh>Limit</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Kind">@ProviderDisplay.KindName(context.Kind)</MudTd>
            <MudTd DataLabel="Base URL"><code>@context.BaseUrl</code></MudTd>
            <MudTd DataLabel="API key">
                <KeyStatusChip Status="context.Key" Auth="context.Auth" />
            </MudTd>
            <MudTd DataLabel="Limit">@LimitText(context)</MudTd>
            <MudTd Style="white-space: nowrap; text-align: right;">
                @if (_testing.Contains(context.Id))
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else if (_results.TryGetValue(context.Id, out var test))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(test.Succeeded ? Color.Success : Color.Error)"
                             Icon="@(test.Succeeded ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.ErrorOutline)">
                        @test.Message
                    </MudChip>
                }
                <MudTooltip Text="Test connection">
                    <MudIconButton Icon="@Icons.Material.Outlined.NetworkCheck" Size="Size.Small"
                                   Disabled="@_testing.Contains(context.Id)" OnClick="() => TestAsync(context)" />
                </MudTooltip>
                <MudTooltip Text="Edit">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => EditAsync(context)" />
                </MudTooltip>
                <MudTooltip Text="Delete">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private IReadOnlyList<ProviderSummary>? _providers;
    private readonly HashSet<ProviderId> _testing = [];
    private readonly Dictionary<ProviderId, ConnectionTestResult> _results = [];

    private static string LimitText(ProviderSummary provider) => provider.RateLimit is { } limit
        ? string.Join(", ", new[] { $"{limit.MaxConcurrency} concurrent", limit.RequestsPerSecond is { } r ? $"{r:0.##}/s" : null }.OfType<string>())
        : "Default";

    private async Task TestAsync(ProviderSummary provider)
    {
        _testing.Add(provider.Id);
        _results.Remove(provider.Id);
        var result = await UseCases.SendAsync<TestProviderConnection, ConnectionTestResult>(new TestProviderConnection(provider.Id));
        _testing.Remove(provider.Id);
        if (result.IsSuccess)
        {
            _results[provider.Id] = result.Value;
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private async Task EditAsync(ProviderSummary provider)
    {
        var parameters = new DialogParameters<RegisterProviderDialog> { { x => x.Existing, provider } };
        var dialog = await Dialogs.ShowAsync<RegisterProviderDialog>($"Edit {provider.Name}", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            _results.Remove(provider.Id);
            Snackbar.Add("Provider saved.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(ProviderSummary provider)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            $"Delete {provider.Name}?",
            "Its stored API key is deleted too. This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        var result = await UseCases.SendAsync<DeleteProvider, ProviderId>(new DeleteProvider(provider.Id));
        if (result.IsSuccess)
        {
            Snackbar.Add("Provider deleted.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() =>
        _providers = await UseCases.QueryAsync<ListProviders, IReadOnlyList<ProviderSummary>>(new ListProviders());

    private async Task RegisterAsync()
    {
        var dialog = await Dialogs.ShowAsync<RegisterProviderDialog>("Register provider");
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Provider registered.", Severity.Success);
            await LoadAsync();
        }
    }
}
