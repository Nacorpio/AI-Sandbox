@using AISandbox.Application.Features.Providers
@using AISandbox.Domain.Catalog.Providers
@inject UseCases UseCases

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudSelect T="ProviderKind" Label="Kind" Value="_kind" ValueChanged="KindChanged" Variant="Variant.Outlined"
                       Disabled="@IsEdit">
                @foreach (var kind in Enum.GetValues<ProviderKind>())
                {
                    <MudSelectItem Value="kind">@ProviderDisplay.KindName(kind)</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Required="true"
                          Error="@HasError("name")" ErrorText="@ErrorFor("name")" MaxLength="Provider.MaxNameLength" />

            <MudTextField @bind-Value="_baseUrl" Label="Base URL" Variant="Variant.Outlined" Required="true"
                          Error="@HasError("baseUrl")" ErrorText="@ErrorFor("baseUrl")" InputType="InputType.Url" />

            @if (_kind == ProviderKind.CloudflareWorkersAi)
            {
                <MudTextField @bind-Value="_accountId" Label="Account id" Variant="Variant.Outlined" Required="true"
                              Error="@HasError("pathVariables")" ErrorText="@ErrorFor("pathVariables")"
                              HelperText="Your Cloudflare account id, used in the request URL." />
            }

            <MudTextField @bind-Value="_apiKey" Label="API key" Variant="Variant.Outlined" InputType="InputType.Password"
                          Disabled="@(_auth == AuthSchemeKind.None)" Placeholder="@(IsEdit ? "unchanged" : null)"
                          HelperText="@KeyHelp" autocomplete="off" />

            <MudExpansionPanels Elevation="0" Outlined="true">
                <MudExpansionPanel Text="More options">
                    <MudStack Spacing="3">
                        <MudSelect T="AuthSchemeKind" @bind-Value="_auth" Label="Authentication" Variant="Variant.Outlined"
                                   Error="@HasError("auth")" ErrorText="@ErrorFor("auth")">
                            @foreach (var kind in Enum.GetValues<AuthSchemeKind>())
                            {
                                <MudSelectItem Value="kind">@ProviderDisplay.AuthName(kind)</MudSelectItem>
                            }
                        </MudSelect>
                        @if (_auth == AuthSchemeKind.Header)
                        {
                            <MudTextField @bind-Value="_headerName" Label="Header name" Variant="Variant.Outlined" Placeholder="X-Api-Key" />
                        }
                        <MudText Typo="Typo.subtitle2">Rate limit</MudText>
                        <MudNumericField T="int?" @bind-Value="_maxConcurrency" Label="Max concurrency" Variant="Variant.Outlined" Min="1"
                                         Error="@HasError("rateLimit")" ErrorText="@ErrorFor("rateLimit")"
                                         HelperText="@ConcurrencyHelp" />
                        <MudNumericField T="double?" @bind-Value="_requestsPerSecond" Label="Requests per second" Variant="Variant.Outlined" Min="0"
                                         HelperText="Optional. Extra calls wait their turn." />
                        <MudNumericField T="double?" @bind-Value="_tokensPerSecond" Label="Tokens per second" Variant="Variant.Outlined" Min="0"
                                         HelperText="Optional. Not enforced yet." />
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>

            @if (_error is { } error && !IsFieldError(error.Code))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@error.Message</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">@(IsEdit ? "Save" : "Register")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>When set, the dialog edits this provider instead of registering a new one.</summary>
    [Parameter] public ProviderSummary? Existing { get; set; }

    private bool IsEdit => Existing is not null;
    private int? _maxConcurrency;
    private double? _requestsPerSecond;
    private double? _tokensPerSecond;

    private ProviderKind _kind = ProviderKind.OpenRouter;
    private string? _name = "OpenRouter";
    private string? _baseUrl = ProviderDefaults.BaseUrlFor(ProviderKind.OpenRouter);
    private string? _apiKey;
    private AuthSchemeKind _auth = AuthSchemeKind.Bearer;
    private string? _headerName;
    private string? _accountId;
    private AISandbox.Domain.Abstractions.Error? _error;
    private bool _saving;

    protected override void OnInitialized()
    {
        if (Existing is not { } existing)
        {
            return;
        }

        _kind = existing.Kind;
        _name = existing.Name;
        _baseUrl = existing.BaseUrl;
        _auth = existing.Auth;
        _headerName = existing.AuthHeaderName;
        _accountId = existing.PathVariables.GetValueOrDefault(Provider.AccountIdVariable);
        _maxConcurrency = existing.RateLimit?.MaxConcurrency;
        _requestsPerSecond = existing.RateLimit?.RequestsPerSecond;
        _tokensPerSecond = existing.RateLimit?.TokensPerSecond;
    }

    private string KeyHelp =>
        (IsEdit ? "The stored key is never shown. Type a new one to replace it. " : "Stored encrypted. ")
        + (ProviderDefaults.EnvironmentVariableFor(_kind) is { } variable
            ? $"{variable} overrides it when set."
            : IsEdit ? string.Empty : "Leave empty to add later.");

    private const string ConcurrencyHelp = "Simultaneous calls to this provider. Leave all rate-limit fields empty to use the default.";

    private RateLimitSettings? RateLimit() => new(_maxConcurrency, _requestsPerSecond, _tokensPerSecond);

    private void KindChanged(ProviderKind kind)
    {
        // Replace the prefilled values only if the user has not typed their own.
        if (_name == ProviderDisplay.KindName(_kind) || string.IsNullOrWhiteSpace(_name))
        {
            _name = ProviderDisplay.KindName(kind);
        }

        if (_baseUrl == ProviderDefaults.BaseUrlFor(_kind) || string.IsNullOrWhiteSpace(_baseUrl))
        {
            _baseUrl = ProviderDefaults.BaseUrlFor(kind);
        }

        _kind = kind;
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        var result = Existing is { } existing
            ? await UseCases.SendAsync<UpdateProvider, ProviderId>(
                new UpdateProvider(existing.Id, _name, _baseUrl, _auth, _headerName, _apiKey, PathVariables(), RateLimit()))
            : await UseCases.SendAsync<RegisterProvider, ProviderId>(
                new RegisterProvider(_name, _kind, _baseUrl, _auth, _headerName, _apiKey, PathVariables(), RateLimit()));
        _saving = false;

        if (result.IsSuccess)
        {
            _apiKey = null;
            MudDialog.Close(DialogResult.Ok(result.Value));
            return;
        }

        _error = result.Error;
    }

    private IReadOnlyDictionary<string, string>? PathVariables() =>
        _kind == ProviderKind.CloudflareWorkersAi && !string.IsNullOrWhiteSpace(_accountId)
            ? new Dictionary<string, string> { [Provider.AccountIdVariable] = _accountId }
            : null;

    private static bool IsFieldError(string code) => code is "validation.name" or "validation.baseUrl" or "validation.auth" or "validation.pathVariables" or "validation.rateLimit";

    private bool HasError(string field) => _error?.Code == $"validation.{field}";

    private string? ErrorFor(string field) => HasError(field) ? _error!.Message : null;
}
